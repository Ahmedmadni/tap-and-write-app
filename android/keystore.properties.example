# انسخ هذا الملف إلى android/keystore.properties (لا تضعه في Git) واملأ قيمك الحقيقية.
storeFile=/absolute/path/to/nfcpro-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
# معرّف تطبيق AdMob الحقيقي (ca-app-pub-XXXXXXXX~YYYYYYYY)
admobAppId=REPLACE_ME_ADMOB_APP_ID
